+#if defined(BOARD_CC1101_WAIT_MISO) && BOARD_CC1101_WAIT_MISO
+/* CC1101: after CSn goes low the chip holds SO high (CHIP_RDYn) until its
+ * crystal is running — after SRES or when woken from SLEEP that takes up to
+ * a few hundred microseconds. A header byte clocked in before SO goes low is
+ * lost or garbled (status 0xFF, PARTNUM/VERSION junk). Hardware CS cannot
+ * wait for that, so this handle drives CSn by hand. */
+static bool furi_hal_spi_cs_manual(const FuriHalSpiBusHandle* handle) {
+    return handle == &furi_hal_spi_bus_handle_subghz;
+}
+#else
+static bool furi_hal_spi_cs_manual(const FuriHalSpiBusHandle* handle) {
+    UNUSED(handle);
+    return false;
+}
+#endif
