+/** Wake the PN532 and read its firmware version, retrying a few times.
+ *
+ * Out of power-on (or with no RST line wired) the PN532 can NACK the first
+ * I2C transfers while its oscillator starts, so a single attempt reports a
+ * working chip as missing and NFC stays dead until reboot. */
+static FuriHalNfcError pn532_probe(uint8_t* resp, size_t resp_size) {
+    FuriHalNfcError nfc_err = FuriHalNfcErrorCommunication;
+    for(int attempt = 0; attempt < 5; attempt++) {
+        /* Wake-up: an address-only write (NACK expected while asleep) */
+        i2c_cmd_handle_t wake = i2c_cmd_link_create();
+        if(wake) {
+            i2c_master_start(wake);
+            i2c_master_write_byte(wake, (PN532_I2C_ADDR << 1) | I2C_MASTER_WRITE, false);
+            i2c_master_stop(wake);
+            i2c_master_cmd_begin(BOARD_NFC_I2C_PORT, wake, pdMS_TO_TICKS(50));
+            i2c_cmd_link_delete(wake);
+        }
+        furi_delay_ms(attempt == 0 ? 50 : 200);
+
+        uint8_t cmd[] = {PN532_CMD_GETFIRMWAREVERSION};
+        size_t resp_len = resp_size;
+        nfc_err = pn532_send_command(cmd, sizeof(cmd), resp, &resp_len, 1000);
+        if(nfc_err == FuriHalNfcErrorNone && resp_len >= 4) return FuriHalNfcErrorNone;
+        FURI_LOG_W(TAG, "PN532 probe attempt %d failed (%d)", attempt + 1, nfc_err);
+    }
+    return nfc_err == FuriHalNfcErrorNone ? FuriHalNfcErrorCommunication : nfc_err;
+}
