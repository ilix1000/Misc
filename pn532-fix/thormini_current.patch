diff --git a/components/furi_hal/furi_hal_subghz.c b/components/furi_hal/furi_hal_subghz.c
index 030335ac..c29849e3 100644
--- a/components/furi_hal/furi_hal_subghz.c
+++ b/components/furi_hal/furi_hal_subghz.c
@@ -434,6 +434,23 @@ static void furi_hal_subghz_log_probe(const FuriHalSubGhzProbe* probe, bool conn
         hint);
 }
 
+bool furi_hal_subghz_probe_now(uint8_t* part_out, uint8_t* ver_out) {
+    FuriHalSubGhzProbe probe = {0};
+    bool ok = furi_hal_subghz_probe_read(&probe, false);
+    furi_hal_subghz_log_probe(&probe, ok);
+    if(part_out) *part_out = probe.partnumber;
+    if(ver_out) *ver_out = probe.version;
+    return ok;
+}
+
+void furi_hal_subghz_get_pins(int* csn, int* sck, int* mosi, int* miso, int* gdo0) {
+    if(csn) *csn = BOARD_PIN_CC1101_CSN;
+    if(sck) *sck = BOARD_PIN_CC1101_SCK;
+    if(mosi) *mosi = BOARD_PIN_CC1101_MOSI;
+    if(miso) *miso = BOARD_PIN_CC1101_MISO;
+    if(gdo0) *gdo0 = BOARD_PIN_CC1101_GDO0;
+}
+
 int32_t furi_hal_subghz_get_rolling_counter_mult(void) {
     return furi_hal_subghz.rolling_counter_mult;
 }
